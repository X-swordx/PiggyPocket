# ============================================================
# 0. Compose 项目与容器前缀
# ============================================================

# 同一台服务器跑 production / stage 时用不同的项目名和容器前缀
COMPOSE_PROJECT_NAME=piggy-pocket
CONTAINER_PREFIX=piggy

# ============================================================
# 1. 域名配置
# ============================================================

# 最终给微信小程序访问的 HTTPS 域名
# 例如：DOMAIN=api.yourdomain.com
DOMAIN=api.yourdomain.com

# ============================================================
# 2. 云服务器数据目录（请根据实际路径修改）
# ============================================================

# 数据持久化目录
DATA_DIR=/home/admin/PiggyPocket/data

# 数据库备份目录
BACKUP_DIR=/home/admin/PiggyPocket/backup

# 备份保留天数
BACKUP_RETENTION_DAYS=7

# ============================================================
# 3. MySQL 配置
# ============================================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=YourStrongRootPassword

# 应用数据库配置
DB_DATABASE=piggy_pocket
DB_USERNAME=piggy
DB_PASSWORD=YourStrongUserPassword

# 只绑定到本机，避免 MySQL 直接暴露公网；stage 与 production 同机时改端口
MYSQL_BIND_PORT=3306

# 生产默认关闭 SQL 日志；排查时临时设 true
DB_LOGGING=false

# ============================================================
# 4. 微信小程序配置
# ============================================================

WECHAT_APPID=wxYourAppId
WECHAT_SECRET=YourWechatSecret

# ============================================================
# 5. 后台管理员 JWT 配置
# ============================================================

# 建议设置为 32 字符以上随机字符串，避免使用默认值
ADMIN_JWT_SECRET=YourRandomAdminJwtSecretAtLeast32Chars
ADMIN_JWT_EXPIRES_IN=2h

# ============================================================
# 6. 阿里云 OSS 配置（小程序图片上传使用）
# ============================================================

# 必须和 bucket 实际所在地域一致，填错会返回 AccessDenied（报错体里会给出正确的 Endpoint）
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_REGION=oss-cn-guangzhou
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=your-ak
OSS_ACCESS_KEY_SECRET=your-sk

# ============================================================
# 7. AI 配置（菜谱流式生成使用，兼容 OpenAI 协议）
# ============================================================

MODEL_NAME=ark-code-latest
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# ============================================================
# 8. 到期管家配置（订阅消息提醒 + 语义搜索，留空则功能自动降级）
# ============================================================

# 小程序后台申请的「到期提醒」订阅消息模板 ID，留空则不推送微信通知
WECHAT_EXPIRY_TEMPLATE_ID=your-expiry-template-id

# Zilliz Cloud（托管 Milvus）连接信息，留空则语义搜索降级为关键词匹配
MILVUS_ADDRESS=https://your-milvus-instance.example.com
MILVUS_TOKEN=your-milvus-token

# 向量模型（走上面的 OPENAI_BASE_URL / OPENAI_API_KEY），维度需与模型一致
EMBEDDING_MODEL_NAME=doubao-embedding-vision
EMBEDDING_DIM=2048

# ============================================================
# 9. 拉粑粑么配置（每日排便提醒，留空则不推送微信通知）
# ============================================================

# 小程序后台申请的「排便提醒」订阅消息模板 ID
WECHAT_POOP_TEMPLATE_ID=your-poop-template-id

# ============================================================
# 10. Nginx Proxy Manager 端口
# ============================================================

# stage 与 production 同机时改这三项，例如 8080/8081/8443
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443

# ============================================================
# 11. 告警与健康检查
# ============================================================

# 企业微信/钉钉机器人 webhook；留空则只写日志不推送
ALERT_WEBHOOK_URL=

# 可选：从公网验证的 API 健康检查地址，例如 https://api.example.com/api/health/ready
PUBLIC_HEALTH_URL=
