# Stage 环境变量：与 production 完全隔离
# 复制为 .env.stage 后再填写；不要提交 .env.stage。

COMPOSE_PROJECT_NAME=piggy-pocket-stage
CONTAINER_PREFIX=piggy-stage

# Stage 独立域名（NPM 里单独建 Proxy Host）
DOMAIN=stage-api.yourdomain.com

# Stage 独立数据目录，避免和 production 共用 MySQL 数据
DATA_DIR=/home/admin/PiggyPocket/stage/data
BACKUP_DIR=/home/admin/PiggyPocket/stage/backup
BACKUP_RETENTION_DAYS=3

# Stage 独立数据库
MYSQL_ROOT_PASSWORD=YourStageRootPassword
DB_DATABASE=piggy_pocket_stage
DB_USERNAME=piggy
DB_PASSWORD=YourStageUserPassword
MYSQL_BIND_PORT=3307
DB_LOGGING=false

# Stage 用微信测试号/测试小程序，不要复用 production 的 AppID
WECHAT_APPID=wxYourStageAppId
WECHAT_SECRET=YourStageWechatSecret

ADMIN_JWT_SECRET=YourStageAdminJwtSecretAtLeast32Chars
ADMIN_JWT_EXPIRES_IN=2h

# Stage 独立 OSS bucket 或至少独立前缀，避免测试数据污染生产
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_REGION=oss-cn-guangzhou
OSS_BUCKET=your-stage-bucket
OSS_ACCESS_KEY_ID=your-stage-ak
OSS_ACCESS_KEY_SECRET=your-stage-sk

# Stage 可以指向测试模型/测试 key
MODEL_NAME=ark-code-latest
OPENAI_API_KEY=your-stage-api-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
VISION_MODEL_NAME=doubao-seed-2.0-mini

WECHAT_EXPIRY_TEMPLATE_ID=your-stage-expiry-template-id
MILVUS_ADDRESS=https://your-stage-milvus-instance.example.com
MILVUS_TOKEN=your-stage-milvus-token
EMBEDDING_MODEL_NAME=doubao-embedding-vision
EMBEDDING_DIM=2048
WECHAT_POOP_TEMPLATE_ID=your-stage-poop-template-id

# Stage 与 production 同机时用不同端口，避免 80/81/443 冲突
NPM_HTTP_PORT=8080
NPM_ADMIN_PORT=8081
NPM_HTTPS_PORT=8443

ALERT_WEBHOOK_URL=
PUBLIC_HEALTH_URL=https://stage-api.yourdomain.com/api/health/ready
