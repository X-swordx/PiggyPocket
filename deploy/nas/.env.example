# 域名配置
DOMAIN=api.yourdomain.com

# 数据与备份目录（NAS 上的绝对路径）
DATA_DIR=/volume1/docker/piggy-pocket/data
BACKUP_DIR=/volume1/docker/piggy-pocket/backup
SSL_DIR=/volume1/docker/piggy-pocket/ssl

# MySQL 配置
MYSQL_ROOT_PASSWORD=YourStrongRootPassword
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=piggy
DB_PASSWORD=YourStrongUserPassword
DB_DATABASE=piggy_pocket

# 微信小程序配置
WECHAT_APPID=wx your appid
WECHAT_SECRET=your secret

# OSS 配置（如使用）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=your-ak
OSS_ACCESS_KEY_SECRET=your-sk
