# 应用配置面板
VITE_APP_SETTING = false

# 网站标题
VITE_APP_TITLE = 猪猪生活本 · 后台管理

# 网络请求地址，应用于 axios 的 baseURL（nginx 反代到 nest-service）
VITE_APP_API_BASEURL = /api

# localStorage/sessionStorage 前缀
VITE_APP_STORAGE_PREFIX = pp_admin_

# 调试工具
VITE_APP_DEBUG_TOOL =

# ===== 以下配置仅在生产环境生效 =====

# 启用假数据
VITE_BUILD_FAKE = false

# 启用 sourcemap
VITE_BUILD_SOURCEMAP = false

# 压缩方式
VITE_BUILD_COMPRESS = gzip

# 构建后生成存档
VITE_BUILD_ARCHIVE =
