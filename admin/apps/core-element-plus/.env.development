# 应用配置面板
VITE_APP_SETTING = true

# 网站标题
VITE_APP_TITLE = 猪猪生活本 · 后台管理

# 网络请求地址，应用于 axios 的 baseURL
VITE_APP_API_BASEURL = http://localhost:3000/api

# localStorage/sessionStorage 前缀
VITE_APP_STORAGE_PREFIX = pp_admin_dev_

# 调试工具，可设置 eruda 或 vconsole
VITE_APP_DEBUG_TOOL =

# ===== 以下配置仅在开发环境生效 =====

# 启用代理（true 时前端通过 /proxy 转发到 VITE_APP_API_BASEURL）
VITE_ENABLE_PROXY = true

# 启用 Vue 开发工具
VITE_ENABLE_VUE_DEVTOOLS = false

# 启用 turbo console
VITE_ENABLE_TURBO_CONSOLE = false

# 启动编辑器
VITE_LAUNCH_EDITOR = code
